# Z4 AI Life Manager — Environment Variables
# Copy this to .env.local and fill in your values
# Get Supabase credentials at https://supabase.com
# Get Groq API key at https://groq.com

# Supabase
# IMPORTANT: NEXT_PUBLIC_SUPABASE_URL must be a valid http(s) URL
# (e.g. https://your-project-ref.supabase.co) or the production build will fail.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq (for AI Assistant)
GROQ_API_KEY=your-groq-api-key

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Sentry (optional, for error monitoring)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
